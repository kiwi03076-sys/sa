
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Importadora Celeste: repuestos y autopartes para tu vehículo.">
  <title>Importadora Celeste | Repuestos para vehículos</title>

  <style>
    :root {
      --azul: #102d50;
      --rojo: #e63946;
      --claro: #f4f6f9;
      --texto: #263238;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      font-family: Arial, Helvetica, sans-serif;
      color: var(--texto);
      line-height: 1.6;
    }

    a { text-decoration: none; }

    .contenedor {
      width: min(1120px, 92%);
      margin: auto;
    }

    header {
      background: var(--azul);
      color: white;
      padding: 18px 0;
    }

    .navegacion {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
      flex-wrap: wrap;
    }

    .logo {
      font-size: 23px;
      font-weight: 800;
      color: white;
    }

    nav {
      display: flex;
      gap: 20px;
      flex-wrap: wrap;
    }

    nav a { color: white; }

    .hero {
      background: linear-gradient(120deg, #102d50, #235783);
      color: white;
      text-align: center;
      padding: 90px 20px;
    }

    .hero h1 {
      font-size: clamp(30px, 5vw, 48px);
      line-height: 1.15;
      margin-bottom: 16px;
    }

    .boton {
      display: inline-block;
      background: var(--rojo);
      color: white;
      padding: 13px 24px;
      margin-top: 18px;
      border-radius: 6px;
      font-weight: bold;
      transition: transform 0.2s, opacity 0.2s;
    }

    .boton:hover {
      opacity: 0.9;
      transform: translateY(-2px);
    }

    section { padding: 65px 0; }

    .titulo {
      text-align: center;
      color: var(--azul);
      font-size: 32px;
      margin-bottom: 30px;
    }

    .nosotros {
      text-align: center;
      max-width: 760px;
      margin: auto;
    }

    .categorias { background: var(--claro); }

    .rejilla {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 22px;
    }

    .tarjeta {
      background: white;
      padding: 28px 20px;
      text-align: center;
      border-radius: 10px;
      box-shadow: 0 4px 18px #102d5010;
    }

    .tarjeta .icono { font-size: 38px; }

    .tarjeta h3 {
      color: var(--azul);
      margin-bottom: 8px;
    }

    .marcas {
      display: flex;
      justify-content: center;
      gap: 30px;
      flex-wrap: wrap;
      font-size: 20px;
      font-weight: bold;
    }

    .promocion {
      background: var(--azul);
      color: white;
      text-align: center;
      padding: 50px 20px;
    }

    .testimonio {
      background: var(--claro);
      border-radius: 10px;
      padding: 22px;
    }

    footer {
      background: #0b1e33;
      color: white;
      padding: 40px 0;
    }

    footer a { color: white; }

    .whatsapp-flotante {
      position: fixed;
      bottom: 22px;
      right: 22px;
      background: #25d366;
      color: white;
      border-radius: 50px;
      padding: 14px 20px;
      font-weight: bold;
      box-shadow: 0 4px 14px #0003;
      z-index: 10;
    }

    .whatsapp-flotante:hover { background: #1ebe5d; }

    @media (max-width: 700px) {
      .rejilla { grid-template-columns: 1fr; }
      .navegacion { justify-content: center; }
      nav { justify-content: center; }
      .hero { padding: 65px 18px; }
      section { padding: 45px 0; }
    }
  </style>
</head>

<body>
